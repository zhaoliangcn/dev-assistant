# ── Dev-Assistant-RS 环境变量配置 ──
# 复制本文件为 .env，填入你的 API Key 后即可使用。
# cp .env.example .env

# LLM Provider（openai / anthropic / ollama / shangtang 等）
# LLM_PROVIDER=openai

# API 端点 URL
# LLM_API_URL=https://api.openai.com/v1

# API 密钥（从对应平台获取）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称
# LLM_MODEL=gpt-4o

# 模型参数（可选）
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=65536

# Agent 最大迭代次数（可选，默认 8）
# MAX_ITERATIONS=80

# 允许执行的命令白名单（逗号分隔，可选）
# COMMAND_WHITELIST=cargo build,cargo test,git status

# ── 多模型配置（可选）──
# 如需多个模型，请复制 .dev-assistant-models_example.toml 为
# .dev-assistant-models.toml 放到可执行文件所在目录（如 target/release/），
# 并配置各模型的 API Key 环境变量。
# 也可用 --config /path/to/.dev-assistant-models.toml 显式指定配置文件位置。
# DEEPSEEK_API_KEY=sk-xxxx
# MOONSHOT_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
